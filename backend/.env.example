# Скопируйте в backend/.env:  Copy-Item .env.example .env
#
# SECRET_KEY обязателен: без него приложение не стартует.
# Сгенерировать: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Ниже значения по умолчанию, привязанные к этой машине.
# Их можно не задавать: config.py сам строит абсолютные пути от корня backend/.
DATABASE_URL=sqlite:///C:/projects/StudyMate/backend/studymate.db
STORAGE_DIR=C:/projects/StudyMate/backend/storage
MAX_UPLOAD_MB=20
# Материал длиннее этого числа токенов (примерно 40 страниц) не принимается.
MAX_MATERIAL_TOKENS=30000
ACCESS_TOKEN_TTL_MINUTES=1440
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# GigaChat. Ключ авторизации из проекта GigaChat API (раздел «Настройки API»).
# Без него генерация вопросов вернёт 502, остальное приложение работает.
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-3-Ultra
GIGACHAT_TIMEOUT=120
# Локально оставьте false: проверка сертификата требует корневого сертификата
# Минцифры. Для продакшена задайте true и укажите GIGACHAT_CA_BUNDLE_FILE.
GIGACHAT_VERIFY_SSL=false

# Параметры запуска в разработке (uv run python -m app.main).
HOST=127.0.0.1
PORT=8000
# false отключает автоперезапуск, если его блокирует антивирус.
RELOAD=true
